---
import Base from '../layouts/Base.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { u } from '../lib/url';
import { img } from '../lib/images';
import { organisation, person } from '../lib/strukturdaten';
import { testimonials } from '../lib/stimmen';
import '@fontsource/playfair-display/600.css'; // „Bekannt aus"-Band

// Berichte über Per und die App, die online nachlesbar sind (recherchiert
// 11/2026). Belegbare Nennungen helfen Suchmaschinen und KI-Systemen, Per
// als Ansprechpartner fürs Thema einzuordnen.
const presse = [
  {
    medium: 'stern TV',
    thema: 'Haushaltsbuch',
    titel: 'Bericht zur Sondersendung „So teuer ist Deutschland“',
    url: 'https://www.gmx.net/magazine/unterhaltung/tv-shows/stern-tv-spezial-teuer-deutschland-experte-rechnet-benzinpreis-hoffnung-36414250',
  },
  {
    medium: 'BILD',
    thema: 'App-Test',
    titel: 'Digitales Haushaltsbuch: BILD testet Apps im Vergleich',
    url: 'https://www.bild.de/bild-plus/ratgeber/2023/ratgeber/digitales-haushaltsbuch-bild-testet-apps-im-vergleich-83484730.bild.html',
  },
  {
    medium: 'Berliner Zeitung',
    thema: 'Geld in der Partnerschaft',
    titel: 'Wie Paare Streit ums Geld vermeiden können',
    url: 'https://archiv.berliner-zeitung.de/ratgeber/verbraucher/geld/tipps-von-profis-wie-paare-streit-ums-geld-vermeiden-koennen-33257196',
  },
  {
    medium: 'Nordkurier',
    thema: 'Geld in der Partnerschaft',
    titel: 'So vermeiden Sie Streit um Geld',
    url: 'https://www.nordkurier.de/ratgeber/so-vermeiden-sie-streit-um-geld-0836043907.html',
  },
  {
    medium: 'ING',
    thema: 'Vermögensaufbau',
    titel: 'So klappt der Vermögensaufbau',
    url: 'https://www.ing.de/wissen/tipps-vermoegensaufbau/',
  },
  {
    medium: 'iphone-ticker.de',
    thema: 'App-Test',
    titel: 'OnePeek-App: Ein super-simples Haushaltsbuch aus Oldenburg',
    url: 'https://www.iphone-ticker.de/onepeek-ein-super-simples-haushaltsbuch-aus-oldenburg-188725/',
  },
];

---
<Base
  title="Über Per Schippl"
  description="Per Schippl räumt seit 2016 mit dem Geld-Chaos auf: Struktur und Ordnung in den Finanzen — verständlich, ehrlich und ohne Fachchinesisch."
  active="ueber"
  bild="/og/ueber.png"
>
  <!-- HERO -->
  <div style="background:var(--gv-blue);">
    <div class="gv-wrap" style="padding-top:56px; padding-bottom:64px;">
      <div class="gv-split" style="display:grid; grid-template-columns:1.05fr .95fr; gap:52px; align-items:center;">
        <div>
          <div style="font-family:var(--font-display); font-size:17px; letter-spacing:.12em; color:var(--gv-yellow); margin-bottom:16px;">ÜBER PER SCHIPPL</div>
          <h1 style="font-family:var(--font-display); font-weight:400; line-height:1.0; letter-spacing:.01em; color:#fff; margin:0; font-size:clamp(42px,5vw,72px);">Hi, ich bin Per.<br>Ich räume mit dem <span style="color:var(--gv-yellow);">Geld-Chaos</span> auf.</h1>
          <p style="font-size:19px; line-height:1.6; color:#FFFFFF; max-width:480px; margin:22px 0 28px;">Seit 2016 widme ich mich einem einzigen Thema: Struktur und Ordnung in den Finanzen — verständlich, ehrlich und ohne Fachchinesisch.</p>
          <div style="display:flex; gap:14px; flex-wrap:wrap;">
            <a class="gv-btn" href={u('/podcast')}>In den Podcast hören</a>
            <a class="gv-btn-ghost" href={u('/crashkurs')}>Kostenloser Crashkurs</a>
          </div>
        </div>
        <img src={img.perUeberHero} alt="Per Schippl im Porträt" width="1200" height="800" style="width:100%; height:460px; object-fit:cover; border-radius:18px; display:block; box-shadow:0 24px 60px rgba(0,0,0,.3);" />
      </div>
    </div>
  </div>

  <!-- KENNST DU DAS -->
  <section style="background:#fff;">
    <div class="gv-wrap" style="padding-top:76px; padding-bottom:76px;">
      <div style="max-width:680px; margin:0 auto; text-align:center;">
        <div class="gv-bar" style="margin-left:auto; margin-right:auto;"></div>
        <h2 class="gv-h2" style="margin-top:16px;">Kennst du das?</h2>
        <p style="font-size:18px; line-height:1.75; color:var(--gv-ink-soft); margin:20px 0 0;">Menschen, die gut verdienen – und trotzdem am Ende des Monats nicht wissen, wo das Geld geblieben ist. Paare, die sich wegen Geld streiten. Nicht, weil zu wenig da ist, sondern weil keine Klarheit da ist. Menschen, die sich seit Jahren vornehmen, endlich etwas zurückzulegen – und es doch nie wirklich tun.</p>
        <p style="font-size:18px; line-height:1.75; color:var(--gv-blue); font-weight:700; margin:18px 0 0;">Genau für diese Menschen gibt es GELD VERSTEHEN.</p>
      </div>
    </div>
  </section>

  <!-- STORY A — WER DAHINTER STECKT -->
  <section style="background:var(--gv-surface);">
    <div class="gv-wrap" style="padding-top:84px; padding-bottom:84px;">
      <div class="gv-split" style="display:grid; grid-template-columns:1.15fr .85fr; gap:52px; align-items:center;">
        <div>
          <div class="gv-bar"></div>
          <p class="gv-eyebrow-plain" style="color:var(--gv-blue); margin:16px 0 8px;">WER DAHINTER STECKT</p>
          <h2 class="gv-h2">Mein Name ist Per.</h2>
          <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:20px 0 14px;">Und ich bin kein Finanzexperte im klassischen Sinne. Kein Wirtschaftsstudium, keine Bankkarriere, keine Vorträge auf Finanzkonferenzen.</p>
          <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0 0 14px;">Was ich habe, ist etwas anderes: Struktur. Einen klaren Kopf für Zahlen. Und einen Umgang mit Geld, der sich für mich – soweit ich zurückdenken kann – immer natürlich angefühlt hat.</p>
          <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0 0 14px;">Und ehrlich gesagt: Ich bin ein bisschen faul. Ich habe keine Lust, mich ständig mit meinen Finanzen zu beschäftigen. Genau deshalb suche ich immer nach der effizientesten Lösung – möglichst wenig Aufwand, trotzdem volle Kontrolle und voller Überblick.</p>
          <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0;">Und genau das ist der Ansatz hinter GELD VERSTEHEN. Denn das brauchen die meisten Menschen: etwas Pragmatisches, Schlankes, das man wirklich umsetzt. Auch – und gerade – wenn man so bequem ist wie ich.</p>
        </div>
        <img src={img.perStory} alt="Per Schippl im Gespräch" width="1200" height="800" loading="lazy" decoding="async" style="width:100%; height:380px; object-fit:cover; border-radius:18px; display:block;" />
      </div>
    </div>
  </section>

  <!-- STORY B — DER WEG -->
  <section style="background:#fff;">
    <div class="gv-wrap" style="padding-top:84px; padding-bottom:84px;">
      <div style="max-width:760px;">
        <div class="gv-bar"></div>
        <p class="gv-eyebrow-plain" style="color:var(--gv-blue); margin:16px 0 8px;">DER WEG</p>
        <h2 class="gv-h2">Wie aus einer Webseite ein System wurde</h2>
        <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:20px 0 14px;">Irgendwann ist mir aufgefallen: Was sich für mich selbstverständlich anfühlt, ist für viele andere Menschen alles andere als selbstverständlich. Im Freundeskreis, in unzähligen Gesprächen – immer wieder dieselben Fragen: Wo bleibt das Geld? Was kann ich mir eigentlich leisten? Warum fährt mein Kontostand seit Jahren Achterbahn?</p>
        <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0 0 14px;">2016 habe ich angefangen, meine Ideen und Lösungen einfach aufzuschreiben – hier, auf geldverstehen.de. Ohne großen Plan. Die Resonanz hat mich überrascht: Menschen haben sich gemeldet, haben gefragt, haben um Hilfe gebeten.</p>
        <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0 0 14px;">Aus der Webseite wurde 2017 ein Buch. Und aus dem Buch kamen immer mehr Anfragen von Menschen, die Hilfe bei der Umsetzung wollten. So sind die Coachings entstanden – und später weitere Kurse. Über die Jahre habe ich hunderte Menschen dabei begleitet, ihre Finanzen in den Griff zu bekommen – Studenten, Selbstständige, Familien, Gutverdiener. Jeder mit einer anderen Situation.</p>
        <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0 0 14px;">Aber eines hatten fast alle gemeinsam: Es war nicht das Geld, das fehlte. Es war der Überblick.</p>
        <p style="font-size:17px; line-height:1.7; color:var(--gv-ink-soft); margin:0;">Heute ist GELD VERSTEHEN ein Podcast, die App mit weit über 100.000 Downloads – und bald erscheint mein Buch in einer komplett überarbeiteten Neuauflage: mit allem, was ich seit der ersten Version von 2017 aus hunderten Begleitungen gelernt habe. Noch klarer auf den einen Punkt gebracht: Geld zu verstehen.</p>
      </div>
    </div>
  </section>

  <!-- STERN TV -->
  <section style="background:#0b1f38;">
    <div class="gv-wrap" style="padding-top:80px; padding-bottom:80px;">
      <div class="gv-split" style="display:grid; grid-template-columns:.9fr 1.1fr; gap:52px; align-items:center;">
        <div>
          <div style="font-family:var(--font-display); font-size:16px; letter-spacing:.16em; color:var(--gv-yellow); margin-bottom:16px;">IM FERNSEHEN</div>
          <h2 style="font-family:var(--font-display); font-weight:400; letter-spacing:.01em; color:#fff; line-height:1.04; margin:0; font-size:clamp(32px,4vw,48px);">Zu Gast bei stern TV</h2>
          <p style="font-size:17px; line-height:1.7; color:#C7D6E6; max-width:440px; margin:20px 0 0;">Im Rahmen der stern TV Sondersendung „So teuer ist Deutschland" hat Per über das Thema Haushaltsbuch sowie die Entstehung und die Hintergründe seiner Haushaltsbuch-App gesprochen.</p>
        </div>
        <div style="position:relative; width:100%; aspect-ratio:16/9; border-radius:16px; overflow:hidden; box-shadow:0 24px 60px rgba(0,0,0,.4); background:#000;">
          <YouTubeEmbed id="Awvgf0Dth5Q" title="stern TV Beitrag mit Per Schippl" poster={img.sternTvCover} />
        </div>
      </div>
    </div>
  </section>

  <!-- IN DEN MEDIEN -->
  <section style="background:#fff;">
    <div class="gv-wrap" style="padding-top:84px; padding-bottom:84px;">
      <div class="gv-bar"></div>
      <p class="gv-eyebrow-plain" style="color:var(--gv-blue); margin:16px 0 8px;">IN DEN MEDIEN</p>
      <h2 class="gv-h2">Zum Nachlesen</h2>
      <ul class="gv-medien">
        {presse.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener">
              <span class="gv-medien-quelle">{p.medium}</span>
              <span class="gv-medien-text">
                <span class="gv-medien-thema">{p.thema}</span>
                <span class="gv-medien-titel">{p.titel}</span>
              </span>
              <span class="gv-medien-pfeil" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- VALUES -->
  <section style="background:var(--gv-surface);">
    <div class="gv-wrap" style="padding-top:84px; padding-bottom:84px;">
      <div class="gv-bar"></div>
      <p class="gv-eyebrow-plain" style="color:var(--gv-blue); margin:16px 0 8px;">WOFÜR ICH STEHE</p>
      <h2 class="gv-h2" style="max-width:780px;">Vier Überzeugungen, die alles bestimmen</h2>
      <div class="gv-2" style="display:grid; grid-template-columns:repeat(2,1fr); gap:24px; margin-top:44px;">
        <div class="gv-value">
          <div class="gv-value-num">01</div>
          <h3 class="gv-value-h">Verstehen statt Verzichten</h3>
          <p class="gv-value-p">Es geht nicht darum, dir den Kaffee zu verbieten oder jeden Euro zweimal umzudrehen. Es geht darum, die Prinzipien zu verstehen, die hinter finanziellem Erfolg stecken. Nicht oberflächliche Tricks – das Fundament.</p>
        </div>
        <div class="gv-value">
          <div class="gv-value-num">02</div>
          <h3 class="gv-value-h">Es fehlt nicht das Geld. Es fehlt der Überblick.</h3>
          <p class="gv-value-p">Ich habe Menschen mit kleinem Gehalt begleitet, die am Monatsende etwas übrig hatten. Und Gutverdiener, die sich jeden Monat fragten, wo das Geld geblieben ist.</p>
        </div>
        <div class="gv-value">
          <div class="gv-value-num">03</div>
          <h3 class="gv-value-h">System statt Disziplin</h3>
          <p class="gv-value-p">Gute Finanzen sind keine Frage von Willenskraft. Wenn die Struktur einmal steht, läuft vieles wie von selbst. Mein System ist bewusst schlank gehalten, weil ich selbst keine Lust habe, mehr Zeit als nötig damit zu verbringen.</p>
        </div>
        <div class="gv-value">
          <div class="gv-value-num">04</div>
          <h3 class="gv-value-h">Vergleich dich nicht</h3>
          <p class="gv-value-p">Der Durchschnitt ist niemand. Es kommt nur auf deine Bedürfnisse, deine Werte und deine Ziele an. Vergleich bringt dich von deinem Weg ab.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section style="background:#fff;">
    <div class="gv-wrap" style="padding-top:84px; padding-bottom:84px;">
      <div class="gv-bar"></div>
      <p class="gv-eyebrow-plain" style="color:var(--gv-blue); margin:16px 0 8px;">STIMMEN</p>
      <h2 class="gv-h2" style="max-width:780px;">Was Menschen über den Weg mit GELD VERSTEHEN sagen</h2>
      <div class="gv-2 gv-tgrid" style="display:grid; grid-template-columns:repeat(2,1fr); gap:24px; margin-top:44px;">
        {testimonials.map((t) => (
          <figure class="gv-tcard">
            <div class="gv-tvideo">
              <YouTubeEmbed id={t.id} title={`Erfahrungsbericht von ${t.name}`} label={t.name} poster={t.poster} />
            </div>
            <figcaption class="gv-tbody">
              <p class="gv-thead">„{t.headline}"</p>
              <blockquote class="gv-tquote">„{t.quote}"</blockquote>
              <div class="gv-tname">{t.name}<span class="gv-trole"> · {t.role}</span></div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- PRESS -->
  <div style="border-top:1px solid var(--gv-border); border-bottom:1px solid var(--gv-border);">
    <div class="gv-wrap" style="padding-top:36px; padding-bottom:36px;">
      <div style="font-family:var(--font-display); font-size:13px; letter-spacing:.2em; color:var(--gv-muted); text-align:center; margin-bottom:22px;">BEKANNT AUS</div>
      <div class="gv-press">
        <span>Handelsblatt</span>
        <span>Kölner Stadt-Anzeiger</span>
        <span>Augsburger Allgemeine</span>
        <span>NWZ</span>
        <span>Express</span>
        <span>stern TV</span>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section style="background:var(--gv-blue);">
    <div class="gv-wrap" style="padding-top:80px; padding-bottom:80px; text-align:center;">
      <h2 style="font-family:var(--font-display); font-weight:400; font-size:clamp(38px,4.6vw,56px); line-height:1; color:#fff; margin:0 0 14px;">Lust, dein Geld zu verstehen?</h2>
      <p style="font-size:18px; line-height:1.6; color:#FFFFFF; margin:0 auto 28px; max-width:480px;">Starte mit dem kostenlosen Crashkurs oder hör dich durch den Podcast — in deinem Tempo.</p>
      <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a class="gv-btn" href={u('/crashkurs')}>Kostenlosen Crashkurs sichern</a>
        <a class="gv-btn-ghost" href={u('/podcast')}>Zum Podcast</a>
      </div>
    </div>
  </section>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          ...person,
          image: new URL(img.perHero, Astro.site).href,
          description: 'Per Schippl räumt seit 2016 mit dem Geld-Chaos auf: Struktur und Ordnung in den Finanzen — verständlich, ehrlich und ohne Fachchinesisch.',
          subjectOf: [
            { '@type': 'VideoObject', name: 'stern TV Beitrag mit Per Schippl', url: 'https://www.youtube.com/watch?v=Awvgf0Dth5Q' },
            ...presse.map((p) => ({ '@type': 'Article', name: p.titel, url: p.url, publisher: { '@type': 'Organization', name: p.medium } })),
          ],
        },
        organisation,
      ],
    })}
  />
</Base>

<style>
  .gv-press { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 40px; }
  .gv-press span { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 21px; color: #7c8794; }

  /* In den Medien: eine Zeile pro Bericht */
  .gv-medien { list-style: none; margin: 36px 0 0; padding: 0; border-top: 1px solid var(--gv-border); }
  .gv-medien li { border-bottom: 1px solid var(--gv-border); }
  .gv-medien a { display: grid; grid-template-columns: 220px 1fr auto; gap: 24px; align-items: center; padding: 22px 8px; text-decoration: none; color: inherit; transition: background .15s ease; }
  .gv-medien a:hover { background: var(--gv-surface); }
  .gv-medien a:focus-visible { outline: 2px solid var(--gv-blue); outline-offset: 2px; }
  .gv-medien-quelle { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 21px; color: #7c8794; }
  .gv-medien-text { display: flex; flex-direction: column; gap: 4px; }
  .gv-medien-thema { font-family: var(--font-display); font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--gv-blue); }
  .gv-medien-titel { font-size: 18px; line-height: 1.45; font-weight: 700; color: var(--gv-ink); }
  .gv-medien-pfeil { font-size: 22px; color: var(--gv-blue); transition: transform .15s ease; }
  .gv-medien a:hover .gv-medien-pfeil { transform: translate(2px, -2px); }
  @media (max-width: 720px) {
    .gv-medien a { grid-template-columns: 1fr auto; gap: 6px 16px; padding: 20px 4px; }
    .gv-medien-quelle { grid-column: 1 / -1; font-size: 18px; }
  }

  .gv-value { background: #fff; border: 1px solid var(--gv-border); border-radius: 16px; padding: 30px; }
  .gv-value-num { font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--gv-yellow); }
  .gv-value-h { font-family: var(--font-display); font-weight: 400; font-size: 26px; color: var(--gv-ink); margin: 14px 0 8px; }
  .gv-value-p { font-size: 15px; line-height: 1.6; color: var(--gv-ink-soft); margin: 0; }

  /* Testimonial-Karten (Video + Text) */
  .gv-tgrid { align-items: start; }
  .gv-tcard { display: flex; flex-direction: column; margin: 0; background: var(--gv-surface); border: 1px solid var(--gv-border); border-radius: 16px; overflow: hidden; }
  .gv-tvideo { position: relative; width: 100%; aspect-ratio: 16/9; background: #000; }
  .gv-tvideo iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .gv-tbody { padding: 24px 26px 26px; display: flex; flex-direction: column; }
  .gv-thead { font-family: var(--font-display); font-weight: 400; font-size: 24px; line-height: 1.1; color: var(--gv-ink); margin: 0 0 12px; }
  .gv-tquote { margin: 0; font-size: 15px; line-height: 1.65; color: var(--gv-ink-soft); }
  .gv-tname { margin-top: 16px; font-family: var(--font-body); font-weight: 700; font-size: 15px; color: var(--gv-ink); }
  .gv-trole { font-weight: 400; color: var(--gv-muted); text-transform: uppercase; letter-spacing: .04em; font-size: 13px; }

  @media (max-width: 860px) {
    .gv-split { grid-template-columns: 1fr !important; gap: 32px !important; }
    .gv-3 { grid-template-columns: 1fr !important; }
    .gv-2 { grid-template-columns: 1fr !important; }
  }
</style>
