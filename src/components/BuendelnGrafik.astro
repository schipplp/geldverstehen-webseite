---
// Fehler 1 „Zu viele Kategorien": Pers Beispiel-Kategorien aus dem Text
// laufen in eine einzige, grobe Kategorie zusammen. Einen Namen für die
// Sammelkategorie nennt der Artikel nicht — deshalb steht dort keiner.
import ArtikelGrafik from './ArtikelGrafik.astro';

const fein = ['Lebensmittel', 'Bio-Lebensmittel', 'Getränke', 'Drogerie', 'Tiernahrung'];
---
<ArtikelGrafik fazit="Tendenzen sind wichtiger als Centgenauigkeit.">
  <div class="bg">
    <div class="bg-seite">
      <p class="bg-kopf">zu fein</p>
      <ul class="bg-fein">
        {fein.map((f) => <li>{f}</li>)}
      </ul>
    </div>
    <span class="bg-pfeil" aria-hidden="true">→</span>
    <div class="bg-seite">
      <p class="bg-kopf">besser</p>
      <p class="bg-grob">eine grobe Kategorie</p>
    </div>
  </div>
</ArtikelGrafik>

<style>
  .bg { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; max-width: 600px; margin: 0 auto; }
  .bg-seite { display: grid; gap: 10px; }
  .bg-kopf {
    margin: 0; font-family: var(--font-body); font-size: 13px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--gv-muted);
  }
  .bg-fein { display: flex !important; flex-wrap: wrap; gap: 6px; }
  .bg-fein li {
    font-family: var(--font-body); font-size: 14px; color: var(--gv-ink-soft);
    background: #fff; border: 1px solid var(--gv-border); border-radius: 999px; padding: 5px 12px;
  }
  .bg-pfeil { font-family: var(--font-body); font-size: 28px; font-weight: 700; color: var(--gv-blue); }
  .bg-grob {
    margin: 0; font-family: var(--font-display); font-size: 26px; line-height: 1.05; letter-spacing: .01em;
    color: var(--gv-ink); background: var(--gv-yellow); border-radius: 14px; padding: 18px 20px; text-align: center;
  }

  @media (max-width: 620px) {
    .bg { grid-template-columns: 1fr; gap: 10px; }
    .bg-pfeil { transform: rotate(90deg); justify-self: center; line-height: 1; }
    .bg-grob { font-size: 22px; padding: 14px; }
  }
</style>
