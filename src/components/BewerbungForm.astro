---
// Bewerbungsformular für das Coaching (src/pages/coaching.astro).
//
// Versand: Supabase Edge Function → Resend, siehe src/lib/bewerbung.js.
//
// Felder und Texte von Per am 24.11.2026 so bestätigt.
---
<div class="bw-wrap">
  <form class="bw-form" novalidate>
    <div class="bw-zeile">
      <div class="bw-feld">
        <label for="bw-vorname">Vorname</label>
        <input id="bw-vorname" class="bw-input" type="text" name="Vorname" autocomplete="given-name" required />
        <p class="bw-fehler" role="alert" hidden></p>
      </div>
      <div class="bw-feld">
        <label for="bw-telefon">Telefon</label>
        <input id="bw-telefon" class="bw-input" type="tel" name="Telefon" autocomplete="tel" required />
        <p class="bw-fehler" role="alert" hidden></p>
      </div>
    </div>
    <div class="bw-feld">
      <label for="bw-email">E-Mailadresse</label>
      <input id="bw-email" class="bw-input" type="email" name="email" autocomplete="email" required />
      <p class="bw-fehler" role="alert" hidden></p>
    </div>
    <div class="bw-feld">
      <label for="bw-erreichbar">Wann bist du am besten erreichbar?</label>
      <input id="bw-erreichbar" class="bw-input" type="text" name="Erreichbarkeit" />
    </div>
    <div class="bw-feld">
      <label for="bw-nachricht">Wo stehst du gerade, und was wünschst du dir für deine Finanzen?</label>
      <textarea id="bw-nachricht" class="bw-input bw-textarea" name="Nachricht" rows="5"></textarea>
    </div>
    <!-- Honeypot gegen Bots: muss leer bleiben -->
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="bw-honig" aria-hidden="true" />

    <button class="gv-btn bw-btn" type="submit" data-label="Jetzt auf einen Platz bewerben">Jetzt auf einen Platz bewerben</button>
    <p class="bw-sendefehler" role="alert" hidden></p>
    <p class="bw-hinweis">Deine Angaben nutze ich nur, um mich wegen deiner Bewerbung bei dir zu melden. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
  </form>

  <div class="bw-erfolg" hidden tabindex="-1">
    <div class="bw-check">✓</div>
    <div>
      <div class="bw-erfolg-titel">Deine Bewerbung ist da</div>
      <div class="bw-erfolg-text">Ich melde mich bei dir, und wir vereinbaren ein Telefonat.</div>
    </div>
  </div>
</div>

<style>
  .bw-wrap { max-width: 560px; margin: 0 auto; text-align: left; }
  .bw-form { display: flex; flex-direction: column; gap: 16px; background: #fff; border-radius: 16px; padding: 28px; }
  .bw-zeile { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .bw-feld { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .bw-feld label { font-size: 14px; font-weight: 700; line-height: 1.4; color: var(--gv-ink); }

  .bw-input {
    width: 100%; height: 52px; padding: 0 16px;
    font-family: var(--font-body); font-size: 16px; color: var(--gv-ink);
    background: #fff; border: 1px solid var(--gv-border); border-radius: 8px;
    outline: none; transition: border-color .15s ease, box-shadow .15s ease;
  }
  .bw-textarea { height: auto; padding: 12px 16px; line-height: 1.5; resize: vertical; }
  .bw-input:focus { border-color: var(--gv-blue); box-shadow: 0 0 0 3px rgba(30,115,190,.18); }
  .bw-input--fehler { border-color: var(--gv-error); box-shadow: 0 0 0 3px rgba(214,69,69,.15); }
  .bw-input:disabled { opacity: .7; }

  .bw-fehler, .bw-sendefehler { margin: 0; font-size: 13px; line-height: 1.4; color: var(--gv-error); }
  .bw-honig { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .bw-btn { width: 100%; justify-content: center; height: 56px; font-size: 17px; margin-top: 4px; }
  .bw-btn:disabled { opacity: .8; cursor: default; }
  .bw-hinweis { margin: 0; font-size: 13px; line-height: 1.5; color: var(--gv-muted); }
  .bw-hinweis a { color: inherit; text-decoration: underline; }

  .bw-erfolg { background: #fff; border-radius: 16px; padding: 24px; display: flex; gap: 14px; align-items: flex-start; outline: none; }
  .bw-erfolg[hidden] { display: none; }
  .bw-check {
    flex: none; width: 40px; height: 40px; border-radius: 999px;
    background: var(--gv-success-bg); color: var(--gv-success);
    display: flex; align-items: center; justify-content: center; font-size: 22px; line-height: 1;
  }
  .bw-erfolg-titel { font-family: var(--font-display); font-size: 24px; line-height: 1.1; color: var(--gv-ink); margin-bottom: 4px; }
  .bw-erfolg-text { font-size: 15px; line-height: 1.5; color: var(--gv-ink-soft); }

  @media (max-width: 560px) {
    .bw-form { padding: 20px; }
    .bw-zeile { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { EMAIL_RE } from '../lib/brevo.js';
  import { BEWERBUNG_CONFIG } from '../lib/bewerbung.js';

  document.querySelectorAll<HTMLFormElement>('.bw-form').forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('.bw-btn');
    const sendErr = form.querySelector<HTMLElement>('.bw-sendefehler');
    const success = form.parentElement?.querySelector<HTMLElement>('.bw-erfolg');
    if (!btn || !sendErr || !success) return;
    const label = btn.dataset.label || '';
    const felder = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.bw-input'));
    let submitting = false;

    const errEl = (f: Element) => f.parentElement?.querySelector<HTMLElement>('.bw-fehler');
    const setError = (f: HTMLElement, msg: string) => {
      const el = errEl(f);
      f.classList.toggle('bw-input--fehler', !!msg);
      if (el) { el.textContent = msg; el.hidden = !msg; }
    };
    felder.forEach((f) => f.addEventListener('input', () => setError(f, '')));

    const pruefe = (f: HTMLInputElement | HTMLTextAreaElement) => {
      const v = f.value.trim();
      if (f.required && !v) return 'Bitte fülle dieses Feld aus.';
      if (f.type === 'email' && !EMAIL_RE.test(v)) return 'Bitte gib eine gültige E-Mailadresse ein.';
      return '';
    };

    const sperren = (an: boolean) => {
      btn.disabled = an;
      felder.forEach((f) => (f.disabled = an));
      btn.textContent = an ? 'Wird gesendet…' : label;
    };
    const melde = (ereignis: string, detail?: string) => (window as any).gvCoachingTrack?.(ereignis, detail);
    // Erstes Tippen in einem Feld = Formular begonnen.
    form.addEventListener('input', () => melde('formular_start'), { once: true });
    const fertig = () => {
      melde('bewerbung_gesendet');
      form.hidden = true;
      success.hidden = false;
      success.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      sendErr.hidden = true;

      let erstes: HTMLElement | null = null;
      felder.forEach((f) => {
        const msg = pruefe(f);
        setError(f, msg);
        if (msg && !erstes) erstes = f;
      });
      if (erstes) { (erstes as HTMLElement).focus(); return; }

      // Werte vor dem Sperren lesen.
      const wert = (id: string) => (form.querySelector<HTMLInputElement>(`#${id}`)?.value || '').trim();
      const daten = {
        vorname: wert('bw-vorname'),
        telefon: wert('bw-telefon'),
        email: wert('bw-email'),
        erreichbar: wert('bw-erreichbar'),
        nachricht: wert('bw-nachricht'),
        botcheck: !!form.querySelector<HTMLInputElement>('[name="botcheck"]')?.checked,
        // Kennung aus dem Link (siehe Zähl-Skript in coaching.astro)
        ...((window as any).gvHerkunft || {}),
      };
      submitting = true;
      sperren(true);

      // Prototyp-Modus (kein Endpoint): Erfolg simulieren.
      if (!BEWERBUNG_CONFIG.endpoint) {
        window.setTimeout(fertig, 300);
        return;
      }

      try {
        const res = await fetch(BEWERBUNG_CONFIG.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(daten),
        });
        const json = await res.json().catch(() => null);
        if (!res.ok || !json?.success) throw new Error(json?.message || `HTTP ${res.status}`);
        fertig();
      } catch (err) {
        console.error('Bewerbung fehlgeschlagen:', err);
        melde('bewerbung_fehler');
        sperren(false);
        submitting = false;
        sendErr.textContent = 'Es hat leider nicht geklappt. Bitte versuche es später erneut oder schreib an mail@geldverstehen.de.';
        sendErr.hidden = false;
      }
    });
  });
</script>
