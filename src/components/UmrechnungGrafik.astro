---
// Pers Rechenbeispiel aus Schritt 2: unterschiedliche Rhythmen, auf den
// Monat umgerechnet. Ersetzt die Aufzählung im Text, damit das Beispiel
// nicht doppelt dasteht. Beträge 1:1 aus dem Artikel.
import ArtikelGrafik from './ArtikelGrafik.astro';

const posten = [
  { name: 'Miete', betrag: '500 €', rhythmus: 'pro Monat', teiler: null, monat: '500 €' },
  { name: 'Haftpflicht', betrag: '40 €', rhythmus: 'pro Quartal', teiler: '÷ 4', monat: '10 €' },
  { name: 'KFZ-Steuer', betrag: '120 €', rhythmus: 'pro Jahr', teiler: '÷ 12', monat: '10 €' },
];
---
<ArtikelGrafik fazit="Quartals- und Jahresbeträge, auf den Monat umgerechnet.">
  <ul class="ug">
    {posten.map((p) => (
      <li class="ug-zeile">
        <span class="ug-name">{p.name}</span>
        <span class="ug-original">{p.betrag} <span class="ug-rhythmus">{p.rhythmus}</span></span>
        <span class="ug-pfeil">{p.teiler ?? ''} →</span>
        <span class="ug-monat">{p.monat}</span>
      </li>
    ))}
    <li class="ug-zeile ug-summe">
      <span class="ug-name">Fixkosten im Monat</span>
      <span class="ug-monat">520 €</span>
    </li>
  </ul>
</ArtikelGrafik>

<style>
  .ug { display: grid; gap: 8px; max-width: 560px; margin: 0 auto !important; }
  .ug-zeile {
    display: grid; grid-template-columns: 1.1fr 1.3fr .7fr 90px; align-items: center; gap: 12px;
    background: #fff; border: 1px solid var(--gv-border); border-radius: 12px; padding: 12px 16px;
    font-family: var(--font-body); font-size: 16px; color: var(--gv-ink-soft);
  }
  .ug-name { font-weight: 700; color: var(--gv-ink); }
  .ug-rhythmus { color: var(--gv-muted); }
  .ug-pfeil { color: var(--gv-blue); font-weight: 700; text-align: right; white-space: nowrap; }
  .ug-monat {
    justify-self: end; font-family: var(--font-display); font-size: 24px; line-height: 1;
    color: var(--gv-blue);
  }
  .ug-summe { grid-template-columns: 1fr auto; background: var(--gv-yellow); border-color: var(--gv-yellow); margin-top: 4px; }
  .ug-summe .ug-monat { color: var(--gv-ink); font-size: 28px; }

  @media (max-width: 620px) {
    .ug-zeile { grid-template-columns: 1fr auto; gap: 2px 10px; padding: 10px 14px; font-size: 15px; }
    .ug-name { grid-column: 1; }
    .ug-original { grid-column: 1; grid-row: 2; font-size: 14px; }
    .ug-pfeil { display: none; }
    .ug-monat { grid-column: 2; grid-row: 1 / 3; }
    .ug-summe .ug-monat { grid-row: 1; }
  }
</style>
