---
// Die vier Kategorien als Entscheidungsweg statt als Namensliste.
//
// Eine Vier-Felder-Matrix wäre naheliegend, geht aber nicht auf: „Wackel-
// kandidaten" ist kein Quadrant, sondern der Zustand vor der Einordnung.
// Zwei Fragen nacheinander bilden Pers Modell dagegen genau ab — und sagen
// dem Leser zusätzlich, wie er sortiert.
//
// Farbe nach dem Regelwerk (src/styles/grafik.css): Sie zeigt, was mit der
// Ausgabe passiert. Blau = behalten, weiß = beobachten, gelb = der eine
// Ort, an dem du handelst.
import ArtikelGrafik from './ArtikelGrafik.astro';
---
<ArtikelGrafik
  titel="Die Happy-Balance-Analyse"
  fazit="Zwei Fragen, und jede Ausgabe landet von selbst an ihrem Platz."
>
  <div class="hb">
    <p class="ag-klein hb-start">Eine Ausgabe aus deinem Monat</p>

    <div class="ag-frage">
      <span class="ag-nr">1</span>
      <p>Brauchst du es wirklich?</p>
    </div>

    <div class="hb-zweige">
      <div class="hb-zweig">
        <span class="hb-antwort">ja</span>
        <div class="ag-karte ag-karte-blau hb-karte">
          <p class="ag-name">Notwendigkeiten</p>
          <p class="ag-text">Behalten — aber regelmäßig prüfen, ob der Preis noch stimmt.</p>
          <span class="ag-marke ag-marke-blau">behalten</span>
        </div>
      </div>

      <div class="hb-zweig">
        <span class="hb-antwort">unsicher</span>
        <div class="ag-karte hb-karte">
          <p class="ag-name">Wackelkandidaten</p>
          <p class="ag-text">Noch nichts entscheiden. Einen Monat weiter beobachten.</p>
          <span class="ag-marke">beobachten</span>
        </div>
      </div>

      <div class="hb-zweig hb-zweig-weiter">
        <span class="hb-antwort">nein</span>

        <div class="ag-frage">
          <span class="ag-nr">2</span>
          <p>Macht es dir Freude?</p>
        </div>

        <div class="hb-unterzweige">
          <div class="hb-zweig">
            <span class="hb-antwort">ja</span>
            <div class="ag-karte ag-karte-blau hb-karte">
              <p class="ag-name">Gönn-ich-mir</p>
              <p class="ag-text">Behalten, ohne schlechtes Gewissen. Dafür ist Geld da.</p>
              <span class="ag-marke ag-marke-blau">behalten</span>
            </div>
          </div>
          <div class="hb-zweig">
            <span class="hb-antwort">nein</span>
            <div class="ag-karte ag-karte-gelb hb-karte">
              <p class="ag-name">Geldfresser</p>
              <p class="ag-text">Hier — und nur hier — streichst du. Du verzichtest auf nichts.</p>
              <span class="ag-marke ag-marke-gelb">streichen</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ArtikelGrafik>

<style>
  .hb { display: grid; gap: 12px; }
  .hb-start { font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

  .hb-zweige { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; margin-top: 4px; }
  .hb-zweig-weiter { grid-column: 1 / -1; }
  .hb-unterzweige { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; margin-top: 4px; }
  .hb-zweig { display: grid; grid-template-rows: auto 1fr; gap: 8px; }
  .hb-zweig-weiter { grid-template-rows: auto auto auto; }

  /* Antwort als kleiner Abzweig mit Strich nach oben */
  .hb-antwort {
    justify-self: start; position: relative; padding-left: 14px;
    font-family: var(--font-body); font-weight: 700; font-size: 13px;
    letter-spacing: .08em; text-transform: uppercase; color: var(--gv-ink-soft);
  }
  .hb-antwort::before {
    content: ''; position: absolute; left: 0; top: 50%;
    width: 8px; height: 2px; background: var(--gv-ink-soft);
  }

  .hb-karte { display: grid; gap: 6px; align-content: start; }
  .hb-karte .ag-marke { margin-top: 6px; }

  @media (max-width: 620px) {
    .hb-zweige, .hb-unterzweige { grid-template-columns: 1fr; }
  }
</style>
