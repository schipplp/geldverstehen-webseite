---
// Die drei Geldfluss-Kategorien. Statt Icons zeigt jede Karte in vier
// Mini-Balken, wie sich die Kategorie über die Monate verhält — genau der
// Unterschied, den der Text erklärt: planbar oder schwankend.
// Die Balkenhöhen sind Form, keine echten Beträge. Farben wie in der
// Monatsbilanz-Grafik: Einkommen grün, Fixkosten blau, Flexkosten gelb.
import ArtikelGrafik from './ArtikelGrafik.astro';

const kategorien = [
  { name: 'Einkommen', verhalten: 'planbar', balken: [70, 70, 70, 70], farbe: 'gruen' },
  { name: 'Fixkosten', verhalten: 'planbar', balken: [52, 52, 52, 52], farbe: 'blau' },
  { name: 'Flexkosten', verhalten: 'schwankt', balken: [34, 62, 24, 48], farbe: 'gelb' },
];
---
<ArtikelGrafik
  fazit="Jeder Geldfluss gehört in genau eine dieser drei Kategorien."
  beschreibung="Einkommen und Fixkosten sind jeden Monat gleich. Flexkosten schwanken von Monat zu Monat."
>
  <div class="kg">
    {kategorien.map((k) => (
      <div class="kg-karte">
        <p class="ag-name">{k.name}</p>
        <div class="kg-balken" aria-hidden="true">
          {k.balken.map((h) => (
            <span class:list={['kg-b', `kg-${k.farbe}`]} style={`height:${h}%`}></span>
          ))}
        </div>
        <p class="ag-text">{k.verhalten}</p>
      </div>
    ))}
  </div>
</ArtikelGrafik>

<style>
  .kg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .kg-karte {
    display: grid; gap: 12px; background: #fff; border: 1px solid var(--gv-border);
    border-radius: 12px; padding: 18px;
  }
  .kg-balken { display: flex; align-items: flex-end; gap: 6px; height: 56px; }
  .kg-b { flex: 1; border-radius: 3px 3px 0 0; }
  /* Kategorie-Farben aus Pers Originalgrafiken, wie Monatsbilanz und Happy-Balance */
  .kg-gruen { background: #84D294; }
  .kg-blau { background: #7B97C8; }
  .kg-gelb { background: #F0CB63; }

  @media (max-width: 620px) {
    .kg { gap: 8px; }
    .kg-karte { padding: 12px 10px; gap: 10px; }
    .kg-karte .ag-name { font-size: 19px; }
    .kg-balken { height: 40px; gap: 3px; }
    .kg-karte .ag-text { font-size: 13px; }
  }
</style>
