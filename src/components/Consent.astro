---
// Consent-Banner für Google Analytics und Meta-Pixel (opt-in / DSGVO).
//
// Beide Dienste werden getrennt abgefragt und ausschließlich NACH aktiver
// Einwilligung geladen. Vorher geht kein Request an Google oder Meta (auch
// kein noscript-Bild). IDs stehen in src/lib/analytics.ts; ist dort keine
// gesetzt, erscheint kein Banner.
//
// Gespeichert wird die Auswahl lokal im Browser unter „gv-consent-v2" als
// {v, ga, meta}. Der frühere Eintrag „gv-consent" (granted/denied, nur GA)
// bleibt gültig: Diese Besucher werden einmal nur nach dem Meta-Pixel gefragt.
import { GA_MEASUREMENT_ID, META_PIXEL_ID } from '../lib/analytics';
import { u } from '../lib/url';
const gaId = GA_MEASUREMENT_ID;
const metaId = META_PIXEL_ID;
// still: Banner erscheint nicht von selbst, nur über „Cookie-Einstellungen"
// im Footer. Geladen wird weiterhin nur, was bereits erlaubt ist.
interface Props { still?: boolean }
const { still = false } = Astro.props;
---
{gaId || metaId ? (
  <div id="gv-consent" class="gv-consent" data-ga-id={gaId} data-meta-id={metaId} data-still={still ? "1" : undefined} role="dialog" aria-label="Cookie-Einwilligung" aria-live="polite" hidden>
    <div class="gv-consent-inner">
      <div class="gv-consent-body">
        <p class="gv-consent-text" data-text="alle">
          Wir möchten Google Analytics (Reichweitenmessung) und das Meta-Pixel (Anzeigen auf Facebook und Instagram) einsetzen — aber nur mit deiner Einwilligung. Mehr dazu in der <a href={u('/datenschutz')}>Datenschutzerklärung</a>.
        </p>
        <p class="gv-consent-text" data-text="meta" hidden>
          Neu: Mit dem Meta-Pixel messen wir, wer unsere Seiten besucht, und zeigen dir später auf Facebook und Instagram Anzeigen von GELD VERSTEHEN. Dabei werden Daten an Meta übermittelt, auch in die USA. Bist du damit einverstanden? Mehr dazu in der <a href={u('/datenschutz')}>Datenschutzerklärung</a>.
        </p>
        <div class="gv-consent-wahl" hidden>
          <label class="gv-consent-zeile">
            <input type="checkbox" data-wahl="ga" />
            <span><strong>Google Analytics</strong> Anonyme Reichweitenmessung, um die Website zu verbessern.</span>
          </label>
          <label class="gv-consent-zeile">
            <input type="checkbox" data-wahl="meta" />
            <span><strong>Meta-Pixel</strong> Mit dem Meta-Pixel messen wir, wer unsere Seiten besucht, und zeigen dir später auf Facebook und Instagram Anzeigen von GELD VERSTEHEN. Dabei werden Daten an Meta übermittelt, auch in die USA.</span>
          </label>
        </div>
      </div>
      <div class="gv-consent-actions">
        <button type="button" class="gv-consent-link" data-consent-einstellungen>Einstellungen</button>
        <button type="button" class="gv-consent-btn gv-consent-gleich" data-consent-speichern hidden>Auswahl speichern</button>
        <button type="button" class="gv-consent-btn gv-consent-gleich" data-consent="denied">Ablehnen</button>
        <button type="button" class="gv-consent-btn gv-consent-gleich" data-consent="granted">Akzeptieren</button>
      </div>
    </div>
  </div>
) : null}

<style>
  .gv-consent {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 200;
    background: #fff; color: var(--gv-ink);
    border: 1px solid var(--gv-border); border-radius: 14px;
    box-shadow: 0 18px 48px rgba(21,35,58,.22);
    padding: 18px 20px; max-width: 720px; margin: 0 auto;
    font-family: var(--font-body);
  }
  .gv-consent-inner { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .gv-consent-body { flex: 1; min-width: 240px; }
  .gv-consent-text { margin: 0; font-size: 14px; line-height: 1.55; color: var(--gv-ink-soft); }
  .gv-consent-text a { color: var(--gv-blue); text-decoration: underline; text-underline-offset: 2px; }
  .gv-consent-actions { display: flex; gap: 10px; flex-shrink: 0; }
  .gv-consent-btn { font-family: var(--font-body); font-weight: 700; font-size: 15px; border-radius: 8px; padding: 11px 20px; cursor: pointer; border: 1px solid transparent; transition: background .15s ease, border-color .15s ease; }
  /* „Ablehnen", „Akzeptieren" und „Auswahl speichern" sind bewusst gleich
     gestaltet — keine Option wird optisch bevorzugt. */
  .gv-consent-gleich { background: var(--gv-yellow); color: var(--gv-ink); box-shadow: var(--shadow-cta); }
  .gv-consent-gleich:hover { background: var(--gv-yellow-600); }
  .gv-consent-link { background: none; border: 0; padding: 11px 6px; font-family: var(--font-body); font-size: 14px; color: var(--gv-ink-soft); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  .gv-consent-wahl { display: grid; gap: 10px; margin-top: 12px; }
  .gv-consent-wahl[hidden], .gv-consent-btn[hidden], .gv-consent-link[hidden], .gv-consent-text[hidden] { display: none; }
  .gv-consent-zeile { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.5; color: var(--gv-ink-soft); cursor: pointer; }
  .gv-consent-zeile input { flex: none; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--gv-blue); }
  .gv-consent-zeile strong { display: block; color: var(--gv-ink); }
  @media (max-width: 560px) {
    .gv-consent-actions { width: 100%; flex-wrap: wrap; }
    .gv-consent-btn { flex: 1; }
    .gv-consent-link { width: 100%; text-align: left; padding: 0 0 4px; }
    .gv-consent { max-height: calc(100vh - 32px); overflow-y: auto; }
  }
</style>

<script>
  const el = document.getElementById('gv-consent');
  if (el) {
    const gaId = el.dataset.gaId || '';
    const metaId = el.dataset.metaId || '';
    const KEY = 'gv-consent-v2';
    const ALT = 'gv-consent'; // früher: 'granted' | 'denied', nur Google Analytics
    const VERSION = 2;
    const w = window as any;

    // ga/meta: true = erlaubt, false = abgelehnt, null = noch nicht gefragt
    type Wahl = { ga: boolean | null; meta: boolean | null };
    const lesen = (): Wahl => {
      try {
        const roh = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (roh && roh.v === VERSION) return { ga: !!roh.ga, meta: !!roh.meta };
      } catch { /* unlesbar = wie nicht gefragt */ }
      const alt = localStorage.getItem(ALT);
      if (alt === 'granted' || alt === 'denied') return { ga: alt === 'granted', meta: null };
      return { ga: null, meta: null };
    };

    const loadGA = () => {
      if (!gaId || w.__gvGaLoaded) return;
      w.__gvGaLoaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
      document.head.appendChild(s);
      w.dataLayer = w.dataLayer || [];
      function gtag(){ w.dataLayer.push(arguments); }
      w.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    };

    // Meta-Pixel: Standard-Einbindung ohne noscript-Bild und ohne Nutzerdaten
    // (kein Advanced Matching). autoConfig aus, damit das Pixel nicht von sich
    // aus Klicks oder Seiteninhalte meldet — es sendet nur das PageView.
    const loadMeta = () => {
      if (!metaId || w.__gvMetaLoaded) return;
      w.__gvMetaLoaded = true;
      const n: any = (w.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
      });
      if (!w._fbq) w._fbq = n;
      n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://connect.facebook.net/en_US/fbevents.js';
      document.head.appendChild(s);
      w.fbq('set', 'autoConfig', false, metaId);
      w.fbq('init', metaId);
      w.fbq('track', 'PageView');
    };

    const cookieWeg = (name: string) => {
      const teile = location.hostname.split('.');
      const domains = ['', location.hostname, '.' + location.hostname, '.' + teile.slice(-2).join('.')];
      domains.forEach((d) => {
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/` + (d ? `; domain=${d}` : '');
      });
    };

    const anwenden = (wahl: Wahl) => {
      if (wahl.ga) loadGA();
      if (wahl.meta) loadMeta();
    };

    const text = (name: string) => el.querySelector<HTMLElement>(`[data-text="${name}"]`)!;
    const panel = el.querySelector<HTMLElement>('.gv-consent-wahl')!;
    const btnEinst = el.querySelector<HTMLButtonElement>('[data-consent-einstellungen]')!;
    const btnSpeichern = el.querySelector<HTMLButtonElement>('[data-consent-speichern]')!;
    const box = (name: 'ga' | 'meta') => el.querySelector<HTMLInputElement>(`[data-wahl="${name}"]`)!;

    // nurMeta: Besucher hat früher schon über GA entschieden und wird nur nach
    // dem Meta-Pixel gefragt. „Ablehnen"/„Akzeptieren" betreffen dann nur Meta.
    let nurMeta = false;
    const zeigen = (einstellungenOffen = false) => {
      const wahl = lesen();
      nurMeta = wahl.ga !== null && wahl.meta === null;
      text('alle').hidden = nurMeta;
      text('meta').hidden = !nurMeta;
      // Schalter zeigen die bisherige Wahl; ohne Wahl sind beide aus.
      box('ga').checked = wahl.ga === true;
      box('meta').checked = wahl.meta === true;
      panel.hidden = !einstellungenOffen;
      btnEinst.hidden = einstellungenOffen;
      btnSpeichern.hidden = !einstellungenOffen;
      el.hidden = false;
    };

    const speichern = (neu: { ga: boolean; meta: boolean }) => {
      const alt = lesen();
      localStorage.setItem(KEY, JSON.stringify({ v: VERSION, ga: neu.ga, meta: neu.meta }));
      el.hidden = true;

      const metaWiderruf = alt.meta === true && !neu.meta;
      const gaWiderruf = alt.ga === true && !neu.ga;
      if (metaWiderruf) {
        w.fbq?.('consent', 'revoke');
        cookieWeg('_fbp');
        cookieWeg('_fbc');
      }
      if (gaWiderruf) {
        document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((c) => c === '_ga' || c.startsWith('_ga_')).forEach(cookieWeg);
      }
      // Nach einem Widerruf neu laden, damit der Dienst nicht weiterläuft.
      if (metaWiderruf || gaWiderruf) { location.reload(); return; }
      anwenden(neu);
    };

    const start = lesen();
    anwenden(start);
    if ((start.ga === null || start.meta === null) && !el.dataset.still) zeigen();

    el.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ja = btn.dataset.consent === 'granted';
        const bisher = lesen();
        speichern({ ga: nurMeta ? bisher.ga === true : ja, meta: ja });
      });
    });
    btnEinst.addEventListener('click', () => zeigen(true));
    btnSpeichern.addEventListener('click', () => speichern({ ga: box('ga').checked, meta: box('meta').checked }));

    // „Cookie-Einstellungen" (Footer) öffnet den Banner erneut, direkt mit
    // den beiden Schaltern.
    document.querySelectorAll('[data-gv-consent-open]').forEach((elm) => {
      elm.addEventListener('click', (e) => { e.preventDefault(); zeigen(true); });
    });
  }
</script>
