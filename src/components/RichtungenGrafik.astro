---
// Abwärts- und Aufwärtsspirale als echte Spiralen, nach Pers Original
// (design/uploads/spiralen.png). Abwärts dreht sich nach innen zu, aufwärts
// von innen nach außen. Die Stationen stehen als HTML darunter, damit sie
// auf dem Handy lesbar bleiben.
import ArtikelGrafik from './ArtikelGrafik.astro';

// Archimedische Spirale um (100|100): r wächst gleichmäßig mit dem Winkel.
function spirale(nachInnen: boolean) {
  const windungen = 2.6;
  const schritte = 160;
  const punkte: string[] = [];
  for (let k = 0; k <= schritte; k++) {
    const t = k / schritte;
    const s = nachInnen ? 1 - t : t;          // Zeichenrichtung = Pfeilrichtung
    const winkel = s * windungen * 2 * Math.PI;
    const r = 10 + s * 76;
    const x = 100 + r * Math.cos(winkel);
    const y = 100 + r * Math.sin(winkel);
    punkte.push(`${k === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return punkte.join(' ');
}

const wege = [
  { name: 'Abwärtsspirale', klasse: 'rg-ab', pfad: spirale(true), stationen: ['wegschauen', 'böse Überraschungen', 'das Geld wird eng', 'schlechtes Gewissen'] },
  { name: 'Aufwärtsspirale', klasse: 'rg-auf', pfad: spirale(false), stationen: ['hinschauen & notieren', 'verstehen', 'andere Prioritäten', 'mehr Erfolg mit den Finanzen', 'mehr Spaß'] },
];
---
<ArtikelGrafik
  fazit="Wegschauen führt in die Abwärtsspirale – hinschauen in die Aufwärtsspirale."
  beschreibung="Zwei Spiralen. Die Abwärtsspirale dreht sich nach innen: wegschauen, böse Überraschungen, das Geld wird eng, schlechtes Gewissen. Die Aufwärtsspirale dreht sich nach außen: hinschauen und notieren, verstehen, andere Prioritäten, mehr Erfolg mit den Finanzen, mehr Spaß."
>
  <div class="rg">
    {wege.map((w) => (
      <div class:list={['rg-weg', w.klasse]}>
        <svg class="rg-spirale" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <marker id={`pfeil-${w.klasse}`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
              <path d="M0 0 10 5 0 10z" class="rg-spitze" />
            </marker>
          </defs>
          <path d={w.pfad} class="rg-linie" marker-end={`url(#pfeil-${w.klasse})`} />
        </svg>
        <p class="ag-name rg-name">{w.name}</p>
        <ul class="rg-stationen">
          {w.stationen.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    ))}
  </div>
</ArtikelGrafik>

<style>
  .rg { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; text-align: center; }
  .rg-weg { display: grid; justify-items: center; align-content: start; }
  .rg-spirale { width: 150px; height: 150px; margin-bottom: 14px; }
  .rg-linie { fill: none; stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .rg-ab .rg-linie { stroke: #B8C0CC; }
  .rg-ab .rg-spitze { fill: #B8C0CC; }
  .rg-auf .rg-linie { stroke: var(--gv-blue); }
  .rg-auf .rg-spitze { fill: var(--gv-blue); }

  .rg-name { margin-bottom: 10px; }
  .rg-stationen { display: grid !important; gap: 6px; }
  .rg-stationen li { font-family: var(--font-body); font-size: 16px; line-height: 1.35; color: var(--gv-muted); }
  .rg-auf .rg-stationen li { color: var(--gv-ink); }

  @media (max-width: 620px) {
    .rg { gap: 12px; }
    .rg-spirale { width: 104px; height: 104px; }
    .rg-name { font-size: 20px; }
    .rg-stationen li { font-size: 14px; }
  }
</style>
