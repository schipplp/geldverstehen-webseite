---
// Ersetzt die Spiralen-Grafik: dieselben Stationen als zwei Treppen. Die
// Abwärtsspirale führt Stufe für Stufe nach unten, die Aufwärtsspirale von
// „hinschauen & notieren" Stufe für Stufe nach oben. Die Form zeigt die
// Richtung, ohne dass jemand eine Liste lesen muss.
import ArtikelGrafik from './ArtikelGrafik.astro';

const abwaerts = ['wegschauen', 'böse Überraschungen', 'das Geld wird eng', 'schlechtes Gewissen'];
const aufwaerts = ['hinschauen & notieren', 'verstehen', 'andere Prioritäten', 'mehr Erfolg mit den Finanzen', 'mehr Spaß'];
---
<ArtikelGrafik
  fazit="Wegschauen führt in die Abwärtsspirale – hinschauen in die Aufwärtsspirale."
  beschreibung="Zwei Treppen. Abwärtsspirale, nach unten: wegschauen, böse Überraschungen, das Geld wird eng, schlechtes Gewissen. Aufwärtsspirale, nach oben: hinschauen und notieren, verstehen, andere Prioritäten, mehr Erfolg mit den Finanzen, mehr Spaß."
>
  <div class="rg">
    <div class="rg-weg rg-ab">
      <p class="ag-name rg-name">Abwärtsspirale <span aria-hidden="true">↘</span></p>
      <ol class="rg-treppe">
        {abwaerts.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
      </ol>
    </div>
    <div class="rg-weg rg-auf">
      <p class="ag-name rg-name">Aufwärtsspirale <span aria-hidden="true">↗</span></p>
      <ol class="rg-treppe">
        {aufwaerts.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
      </ol>
    </div>
  </div>
</ArtikelGrafik>

<style>
  .rg { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: end; }
  .rg-name { margin-bottom: 14px; }
  .rg-name span { color: var(--gv-muted); }
  .rg-auf .rg-name span { color: var(--gv-blue); }

  .rg-treppe { display: flex !important; flex-direction: column; gap: 6px; }
  /* Aufwärts: erste Station unten, jede weitere eine Stufe höher */
  .rg-auf .rg-treppe { flex-direction: column-reverse; }

  .rg-treppe li {
    /* jede Stufe rückt ein Stück nach rechts */
    margin-left: calc(var(--i) * 9%) !important;
    width: fit-content; max-width: 100%;
    font-family: var(--font-body); font-size: 15px; font-weight: 700; line-height: 1.3;
    border-radius: 8px; padding: 8px 12px;
    background: #fff; color: var(--gv-muted); border: 1px solid var(--gv-border);
  }
  .rg-auf .rg-treppe li { background: var(--gv-blue); color: #fff; border-color: var(--gv-blue); }

  @media (max-width: 620px) {
    .rg { grid-template-columns: 1fr; gap: 26px; }
    .rg-treppe li { font-size: 14px; margin-left: calc(var(--i) * 7%) !important; }
  }
</style>
