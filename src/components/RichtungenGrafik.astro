---
// Ersetzt die Spiralen-Grafik: dieselben Stationen, als zwei schlichte Wege,
// die mit einer einzigen Entscheidung beginnen — wegschauen oder hinschauen.
import ArtikelGrafik from './ArtikelGrafik.astro';

const wege = [
  { name: 'Abwärtsspirale', farbe: 'grau', stationen: ['wegschauen', 'böse Überraschungen', 'das Geld wird eng', 'schlechtes Gewissen'] },
  { name: 'Aufwärtsspirale', farbe: 'blau', stationen: ['hinschauen & notieren', 'verstehen', 'andere Prioritäten', 'mehr Erfolg mit den Finanzen', 'mehr Spaß'] },
];
---
<ArtikelGrafik fazit="Wegschauen führt in die Abwärtsspirale – hinschauen in die Aufwärtsspirale.">
  <div class="rg">
    {wege.map((w) => (
      <div class:list={['rg-weg', `rg-${w.farbe}`]}>
        <p class="ag-name rg-name">{w.name}</p>
        <ol class="rg-stationen">
          {w.stationen.map((s) => <li>{s}</li>)}
        </ol>
      </div>
    ))}
  </div>
</ArtikelGrafik>

<style>
  .rg { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; text-align: center; }
  .rg-name { display: inline-block; padding-bottom: 6px; border-bottom: 4px solid var(--gv-border); margin-bottom: 14px; }
  .rg-blau .rg-name { border-color: var(--gv-blue); }

  .rg-stationen { display: grid; gap: 0; }
  .rg-stationen li {
    font-family: var(--font-body); font-size: 16px; line-height: 1.4; color: var(--gv-muted);
  }
  /* Kleiner Pfeil zwischen den Stationen */
  .rg-stationen li + li::before {
    content: '↓'; display: block; margin: 2px 0; font-size: 14px; color: var(--gv-border);
  }
  .rg-blau .rg-stationen li { color: var(--gv-ink); }
  .rg-blau .rg-stationen li + li::before { color: var(--gv-blue); }
  .rg-blau .rg-stationen li:first-child { font-weight: 700; }

  @media (max-width: 620px) {
    .rg { gap: 12px; }
    .rg-stationen li { font-size: 14px; }
    .rg-name { font-size: 20px; }
  }
</style>
