---
// Selbst-gehostete Fonts (kein Google Fonts) — wird lokal aus dist/_astro
// ausgeliefert. Entspricht dem Datenschutz-Hinweis „Schriftarten lokal
// eingebunden, keine Verbindung zu Google".
import '@fontsource/bebas-neue/400.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/700.css';
// Kritische Schriftdateien vorab laden, damit sie beim ersten Rendern schon da
// sind (verhindert das sichtbare Nachladen/„Ruckeln" der Schrift).
import bebas400 from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Consent from '../components/Consent.astro';
import { u } from '../lib/url';

export interface Props {
  title: string;
  description: string;
  active?: string;
  /** ungenutzt — Playfair wird direkt in den betreffenden Seiten importiert */
  playfair?: boolean;
  /** Vorschaubild für geteilte Links (Pfad unter public/, 1200 × 630) */
  bild?: string;
  /** og:type — „article" für Ratgeber-Artikel */
  ogTyp?: 'website' | 'article';
}
const { title, description, active = '', bild, ogTyp = 'website' } = Astro.props;
const bildUrl = bild ? new URL(bild, Astro.site).href : undefined;
const fullTitle = title ? `${title} · GELD VERSTEHEN` : 'GELD VERSTEHEN';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <meta name="theme-color" content="#1E73BE" />
  <!-- Smart App Banner: blendet iOS-Safari-Besuchern oben einen App-Store-Hinweis
       ein. Unterstützt keine Kampagnenparameter — bekannt und so gewollt. -->
  <meta name="apple-itunes-app" content="app-id=1571656912" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogTyp} />
  <meta property="og:site_name" content="GELD VERSTEHEN" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="de_DE" />
  {bildUrl && <meta property="og:image" content={bildUrl} />}
  {bildUrl && <meta property="og:image:width" content="1200" />}
  {bildUrl && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={bildUrl ? 'summary_large_image' : 'summary'} />

  <!-- Kritische Fonts vorladen (verhindert Font-Flackern beim Laden) -->
  <link rel="preload" as="font" type="font/woff2" href={bebas400} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={manrope400} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={manrope700} crossorigin />
</head>
<body>
  <SiteNav active={active} />
  <slot />
  <SiteFooter />
  <Consent />
</body>
</html>
